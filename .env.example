# HTTP port. Integer 1–65535. Default 3000 if unset.
PORT=3000

# development | production
NODE_ENV=development

# Behind one reverse proxy (Render, Railway), set TRUST_PROXY=1
# so rate limits use the client address. Do not set true.
# Leave unset for a direct local connection.
# TRUST_PROXY=1

# PostgreSQL connection. Required. Do not commit a real password.
DATABASE_URL="postgresql://notes_app:REPLACE_WITH_YOUR_PASSWORD@localhost:5432/notes_management_dev?schema=public"
